      "description": "React single-page application with a Hayate API",
      "templates": ["api", "workers", "mcp"],
      "required_features": ["openapi"],
      "optional_features": ["mcp", "sql"]
    },
    "astro": {
      "description": "Astro static site with a Hayate API",
