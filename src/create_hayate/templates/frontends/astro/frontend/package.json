{
  "name": "$project_name-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "api:generate": "node scripts/sync-openapi.mjs",
    "api:check": "node scripts/sync-openapi.mjs --check",
    "typecheck": "astro check",
    "check:static": "node scripts/check-static-output.mjs",
    "build": "npm run api:check && npm run typecheck && astro build && npm run check:static",
    "preview": "astro preview",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.1",
    "astro": "7.1.3",
    "preact": "10.29.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "js-yaml": "4.3.0",
    "minimatch": "10.2.5"
  }
}
