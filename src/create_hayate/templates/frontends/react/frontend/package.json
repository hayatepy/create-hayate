{
  "name": "$project_name-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "api:generate": "node scripts/sync-openapi.mjs",
    "api:check": "node scripts/sync-openapi.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "npm run api:check && npm run typecheck && vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "js-yaml": "4.3.0",
    "minimatch": "10.2.5"
  }
}
