[project]
name = "$project_name"
version = "$project_version"
requires-python = "$requires_python"
dependencies = $dependencies

[dependency-groups]
dev = $dev_dependencies

$uv_environments
[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
pythonpath = $pythonpath
$pytest_markers

[tool.ruff]
line-length = 100
target-version = "$ruff_target_version"
$ruff_extend_exclude

[tool.ruff.lint]
select = ["E", "F", "W", "I", "UP", "B", "SIM", "RUF"]$ruff_renderer_config
